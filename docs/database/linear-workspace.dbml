// Use DBML to define your database structure

// Docs: https://dbml.dbdiagram.io/docs

// Proposed target schema; not a dump of the existing database. No AI agent entities.

// IDs are text with entity prefixes and ULIDs. Records use readable demo IDs only.

Project tream_linear {
  database_type: 'PostgreSQL'
  Note: 'Linear-inspired Tream target model. Workspace is the tenant boundary. CRM and Dynamic Data are optional extensions.'
}

Enum workspace_role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

Enum membership_state {
  ACTIVE
  SUSPENDED
  LEFT
}

Enum work_priority {
  NO_PRIORITY
  LOW
  MEDIUM
  HIGH
  URGENT
}

Enum issue_status_category {
  BACKLOG
  UNSTARTED
  STARTED
  COMPLETED
  CANCELED
  DUPLICATE
}

Enum project_status_category {
  PLANNED
  STARTED
  PAUSED
  COMPLETED
  CANCELED
}

Enum initiative_status {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELED
}

Enum issue_relation_type {
  BLOCKS
  RELATED
  DUPLICATES
}

Enum update_health {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

Enum view_resource {
  ISSUES
  PROJECTS
}

Enum view_visibility {
  PRIVATE
  WORKSPACE
}

Enum notification_channel {
  IN_APP
  EMAIL
}

Enum delivery_status {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

Enum integration_status {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

Enum pull_request_status {
  OPEN
  MERGED
  CLOSED
}

Enum review_state {
  COMMENTED
  APPROVED
  CHANGES_REQUESTED
  DISMISSED
}

Enum task_status {
  TODO
  IN_PROGRESS
  DONE
}

Enum dynamic_field_type {
  TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  BOOLEAN
  DATE
  DATETIME
  EMAIL
  PHONE
  URL
  SELECT
  MULTI_SELECT
  STATUS
  USER
  RELATION
  CREATED_AT
  UPDATED_AT
}

Enum idempotency_status {
  PENDING
  COMPLETED
}

Table users {
  id text [pk]
  email text [not null, unique]
  password_hash text
  full_name text [not null]
  avatar_url text
  email_verified_at timestamptz
  disabled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Normalize email before storing. Password hashes use a modern password KDF; never plaintext.'
  checks {
    `btrim(email) <> ''` [name: 'users_state_1']
  }
}

Table refresh_sessions {
  id text [pk]
  user_id text [not null]
  token_hash text [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  last_used_at timestamptz
  user_agent text
  ip_address inet
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `expires_at > created_at`
  }
}

Table auth_tokens {
  id text [pk]
  user_id text [not null]
  purpose text [not null, note: 'MAGIC_LINK, PASSWORD_RESET, EMAIL_VERIFY']
  token_hash text [not null, unique]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `consumed_at IS NULL OR (consumed_at >= created_at AND consumed_at < expires_at)` [name: 'auth_tokens_state_1']
    `purpose IN ('MAGIC_LINK', 'PASSWORD_RESET', 'EMAIL_VERIFY')`
    `expires_at > created_at`
  }
}

Table user_preferences {
  id text [pk]
  user_id text [not null, unique]
  theme jsonb [not null, default: `'{}'::jsonb`]
  locale text [not null, default: 'en']
  timezone text [not null, default: 'UTC']
  preferences jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table workspaces {
  id text [pk]
  name text [not null]
  slug text [not null, unique]
  settings jsonb [not null, default: `'{}'::jsonb`]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'` [name: 'workspaces_state_1']
  }
}

Table memberships {
  id text [pk]
  workspace_id text [not null]
  user_id text [not null]
  role workspace_role [not null]
  state membership_state [not null, default: 'ACTIVE']
  joined_at timestamptz [not null, default: `now()`]
  left_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, user_id) [unique]
  }
  Note: 'Preserve historical memberships; suspend or mark LEFT instead of deleting referenced authors. Active membership is checked by authorization.'
  checks {
    `left_at IS NULL OR left_at >= joined_at` [name: 'memberships_state_2']
    `(state = 'LEFT') = (left_at IS NOT NULL)` [name: 'memberships_state_1']
  }
}

Table workspace_invitations {
  id text [pk]
  workspace_id text [not null]
  email text [not null]
  role workspace_role [not null]
  invited_by_id text [not null]
  token_hash text [not null, unique]
  expires_at timestamptz [not null]
  accepted_by_id text
  accepted_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  checks {
    `revoked_at IS NULL OR revoked_at >= created_at` [name: 'workspace_invitations_state_3']
    `accepted_at IS NULL OR (accepted_at >= created_at AND accepted_at < expires_at)` [name: 'workspace_invitations_state_2']
    `accepted_at IS NULL OR revoked_at IS NULL` [name: 'workspace_invitations_state_1']
    `expires_at > created_at`
    `(accepted_at IS NULL) = (accepted_by_id IS NULL)`
  }
  Note: 'One active invitation per normalized workspace/email requires a partial unique index in SQL.'
}

Table workspace_preferences {
  id text [pk]
  workspace_id text [not null]
  membership_id text [not null]
  sidebar jsonb [not null, default: `'{}'::jsonb`]
  display_preferences jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, membership_id) [unique]
  }
}

Table teams {
  id text [pk]
  workspace_id text [not null]
  name text [not null]
  key text [not null]
  description text
  visibility text [not null, default: 'WORKSPACE']
  timezone text [not null, default: 'UTC']
  cycles_enabled boolean [not null, default: false]
  cycle_duration_weeks integer [not null, default: 2]
  cycle_start_day integer [not null, default: 1]
  cycle_cooldown_days integer [not null, default: 0]
  upcoming_cycles_count integer [not null, default: 3]
  next_issue_number bigint [not null, default: 1]
  retired_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, key) [unique]
  }
  checks {
    `key ~ '^[A-Z][A-Z0-9]{0,9}$'` [name: 'teams_state_1']
    `next_issue_number >= 1`
    `cycle_duration_weeks >= 1`
    `cycle_start_day BETWEEN 0 AND 6`
    `cycle_cooldown_days >= 0`
    `upcoming_cycles_count >= 0`
    `visibility IN ('WORKSPACE', 'PRIVATE')`
  }
  Note: 'Team keys are reserved permanently to avoid reusing historical issue identifiers. Number allocation requires row locking.'
}

Table team_memberships {
  id text [pk]
  workspace_id text [not null]
  team_id text [not null]
  membership_id text [not null]
  role text [not null, default: 'MEMBER']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, team_id, membership_id) [unique]
  }
  checks {
    `role IN ('ADMIN', 'MEMBER')`
  }
}

Table issue_statuses {
  id text [pk]
  workspace_id text [not null]
  team_id text [not null]
  name text [not null]
  category issue_status_category [not null]
  color text
  position integer [not null]
  is_default boolean [not null, default: false]
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, team_id, id) [unique]
    (workspace_id, team_id, name) [unique]
    (workspace_id, team_id, position) [unique]
  }
  Note: 'SQL partial uniqueness allows one non-archived default per team; services require at least one default.'
}

Table project_statuses {
  id text [pk]
  workspace_id text [not null]
  name text [not null]
  category project_status_category [not null]
  color text
  position integer [not null]
  is_default boolean [not null, default: false]
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, name) [unique]
    (workspace_id, position) [unique]
  }
}

Table projects {
  id text [pk]
  workspace_id text [not null]
  name text [not null]
  summary text
  description text
  status_id text [not null]
  priority work_priority [not null, default: 'NO_PRIORITY']
  lead_id text
  created_by_id text [not null]
  start_date date
  target_date date
  completed_at timestamptz
  archived_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  checks {
    `btrim(name) <> ''` [name: 'projects_state_1']
    `archived_at IS NULL OR deleted_at IS NULL` [name: 'projects_lifecycle_exclusive']
    `start_date IS NULL OR target_date IS NULL OR target_date >= start_date`
  }
  Note: 'Progress and issue counts are computed, not persisted. Requires at least one project team at transaction commit.'
}

Table project_teams {
  id text [pk]
  workspace_id text [not null]
  project_id text [not null]
  team_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, project_id, team_id) [unique]
  }
}

Table project_members {
  id text [pk]
  workspace_id text [not null]
  project_id text [not null]
  membership_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, project_id, membership_id) [unique]
  }
}

Table project_milestones {
  id text [pk]
  workspace_id text [not null]
  project_id text [not null]
  name text [not null]
  description text
  target_date date
  position integer [not null]
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, project_id, id) [unique]
  }
}

Table project_updates {
  id text [pk]
  workspace_id text [not null]
  project_id text [not null]
  author_id text [not null]
  body text [not null]
  health update_health [not null]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
}

Table project_subscribers {
  id text [pk]
  workspace_id text [not null]
  project_id text [not null]
  membership_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, project_id, membership_id) [unique]
  }
}

Table cycles {
  id text [pk]
  workspace_id text [not null]
  team_id text [not null]
  number integer [not null]
  name text [not null]
  description text
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, team_id, id) [unique]
    (workspace_id, team_id, number) [unique]
  }
  checks {
    `completed_at IS NULL OR completed_at >= starts_at` [name: 'cycles_state_1']
    `number >= 1`
    `ends_at > starts_at`
  }
  Note: 'Require PostgreSQL exclusion constraint for non-overlapping half-open team cycle windows.'
}

Table issues {
  id text [pk]
  workspace_id text [not null]
  team_id text [not null]
  number bigint [not null]
  identifier text [not null]
  title text [not null]
  description text
  status_id text [not null]
  priority work_priority [not null, default: 'NO_PRIORITY']
  assignee_id text
  created_by_id text [not null]
  project_id text
  milestone_id text
  cycle_id text
  parent_id text
  estimate integer
  due_date date
  sort_order decimal(20,8) [not null, default: 0]
  completed_at timestamptz
  archived_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, team_id, id) [unique]
    (workspace_id, team_id, number) [unique]
    (workspace_id, identifier) [unique]
    (workspace_id, assignee_id)
    (workspace_id, project_id)
    (workspace_id, cycle_id)
  }
  checks {
    `btrim(title) <> ''` [name: 'issues_state_1']
    `archived_at IS NULL OR deleted_at IS NULL` [name: 'issues_lifecycle_exclusive']
    `number >= 1`
    `estimate IS NULL OR estimate >= 0`
    `parent_id IS NULL OR parent_id <> id`
    `milestone_id IS NULL OR project_id IS NOT NULL`
  }
  Note: 'Team changes are explicit transactional transfers; preserve identifier history via issue_identifiers. Reject parent hierarchy cycles in a trigger/service.'
}

Table issue_identifiers {
  id text [pk]
  workspace_id text [not null]
  issue_id text [not null]
  identifier text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, identifier) [unique]
    (workspace_id, issue_id, identifier) [unique]
  }
  Note: 'Registry contains current and previous identifiers. SQL trigger reserves every issues.identifier here on create/transfer; prevents reuse across both tables.'
}

Table issue_relations {
  id text [pk]
  workspace_id text [not null]
  source_issue_id text [not null]
  target_issue_id text [not null]
  type issue_relation_type [not null]
  created_by_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, source_issue_id, target_issue_id, type) [unique]
  }
  checks {
    `source_issue_id <> target_issue_id`
  }
  Note: 'BLOCKS and DUPLICATES are directional. Canonicalize unordered RELATED pairs; reject dependency cycles.'
}

Table issue_comments {
  id text [pk]
  workspace_id text [not null]
  issue_id text [not null]
  author_id text [not null]
  parent_comment_id text
  body text [not null]
  edited_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, issue_id, id) [unique]
  }
  checks {
    `parent_comment_id IS NULL OR parent_comment_id <> id`
  }
}

Table comment_reactions {
  id text [pk]
  workspace_id text [not null]
  comment_id text [not null]
  membership_id text [not null]
  emoji text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, comment_id, membership_id, emoji) [unique]
  }
}

Table issue_subscribers {
  id text [pk]
  workspace_id text [not null]
  issue_id text [not null]
  membership_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, issue_id, membership_id) [unique]
  }
}

Table labels {
  id text [pk]
  workspace_id text [not null]
  name text [not null]
  color text [not null]
  description text
  team_id text
  group_name text
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  Note: 'Nullable team means workspace label. SQL partial unique indexes scope normalized name to workspace or team. Team-label applicability is validated transactionally.'
}

Table issue_labels {
  id text [pk]
  workspace_id text [not null]
  issue_id text [not null]
  label_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, issue_id, label_id) [unique]
  }
}

Table project_labels {
  id text [pk]
  workspace_id text [not null]
  project_id text [not null]
  label_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, project_id, label_id) [unique]
  }
  Note: 'Only workspace-scoped labels apply to projects; enforce in a trigger/service.'
}

Table issue_activity {
  id text [pk]
  workspace_id text [not null]
  issue_id text [not null]
  actor_id text
  event_id text [not null]
  action text [not null]
  changes jsonb [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, event_id, issue_id) [unique]
  }
  Note: 'Append-only human-readable activity derived transactionally from events; changes are historical snapshots, not relational FK claims.'
}

Table issue_templates {
  id text [pk]
  workspace_id text [not null]
  team_id text
  name text [not null]
  description text
  title_template text
  body_template text
  defaults jsonb [not null, default: `'{}'::jsonb`]
  created_by_id text [not null]
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  Note: 'Defaults are validated against the selected issue team and workspace when applying the template.'
}

Table cycle_rollovers {
  id text [pk]
  workspace_id text [not null]
  team_id text [not null]
  issue_id text [not null]
  from_cycle_id text [not null]
  to_cycle_id text [not null]
  rolled_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, issue_id, from_cycle_id) [unique]
  }
  checks {
    `from_cycle_id <> to_cycle_id`
  }
  Note: 'Immutable rollover history. Complete cycle, create target cycle and move eligible issues atomically.'
}

Table initiatives {
  id text [pk]
  workspace_id text [not null]
  name text [not null]
  description text
  status initiative_status [not null, default: 'PLANNED']
  owner_id text
  created_by_id text [not null]
  target_date date
  position integer [not null, default: 0]
  archived_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  checks {
    `archived_at IS NULL OR deleted_at IS NULL` [name: 'initiatives_lifecycle_exclusive']
  }
}

Table initiative_projects {
  id text [pk]
  workspace_id text [not null]
  initiative_id text [not null]
  project_id text [not null]
  position integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, initiative_id, project_id) [unique]
  }
}

Table initiative_updates {
  id text [pk]
  workspace_id text [not null]
  initiative_id text [not null]
  author_id text [not null]
  body text [not null]
  health update_health [not null]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
}

Table documents {
  id text [pk]
  workspace_id text [not null]
  title text [not null]
  body text [not null]
  author_id text [not null]
  project_id text
  team_id text
  initiative_id text
  archived_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  checks {
    `archived_at IS NULL OR deleted_at IS NULL` [name: 'documents_lifecycle_exclusive']
    `num_nonnulls(project_id, team_id, initiative_id) = 1`
  }
  Note: 'Exactly one typed owner; workspace-level standalone documents can be added as a separate explicit use case.'
}

Table files {

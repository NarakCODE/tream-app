  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, recipient_id, event_id, kind) [unique]
    (workspace_id, recipient_id, read_at, created_at)
  }
  checks {
    `num_nonnulls(issue_id, project_id, initiative_id, pull_request_id) <= 1`
  }
  Note: 'Zero typed targets supports workspace notices. Authorize the linked resource before presenting sensitive content.'
}

Table notification_preferences {
  id text [pk]

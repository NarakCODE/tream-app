  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  Note: 'Validate filter schema and same-workspace IDs; authorization also applies to each returned resource.'
  checks {
    `archived_at IS NULL OR deleted_at IS NULL` [name: 'saved_views_lifecycle_exclusive']
  }
}

Table favorites {

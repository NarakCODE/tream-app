  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  checks {
    `num_nonnulls(issue_id, comment_id, project_id, document_id) = 1`
  }
  Note: 'One explicit owner per attachment. SQL partial unique indexes prevent duplicate file/owner associations.'
}

Table saved_views {
  id text [pk]

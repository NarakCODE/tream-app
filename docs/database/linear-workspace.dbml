  }
  checks {
    `num_nonnulls(issue_id, project_id, team_id, initiative_id, view_id) = 1`
  }
  Note: 'SQL partial unique indexes deduplicate each typed target per membership.'
}

Table notifications {
  id text [pk]
  workspace_id text [not null]
  recipient_id text [not null]

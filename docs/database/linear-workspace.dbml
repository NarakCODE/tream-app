  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, pull_request_id, external_id) [unique]
  }
}

Table events {
  id text [pk]
  workspace_id text [not null]
  event_type text [not null]
  schema_version integer [not null]
  aggregate_type text [not null]
  aggregate_id text [not null]
  aggregate_version bigint [not null]
  correlation_id text
  actor_id text
  payload jsonb [not null]
  idempotency_key text [note: 'Command correlation only; one command may emit several events. Command deduplication is owned by idempotency_keys.']
  occurred_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, idempotency_key)
    (workspace_id, aggregate_type, aggregate_id, aggregate_version, id)
    (workspace_id, occurred_at, id)
  }
  Note: 'Append-only facts written with state mutations. Payload resource IDs are immutable snapshots, not foreign keys; Validate the registered (event_type, schema_version) contract before insertion. actor_id maps to actor_membership_id in the event envelope.'
  checks {
    `jsonb_typeof(payload) = 'object'` [name: 'events_state_1']
    `schema_version > 0` [name: 'events_schema_version_positive']
    `aggregate_version > 0` [name: 'events_aggregate_version_positive']
  }
}

// Durable revision counters are historical stream identities, not polymorphic resource FKs.
Table event_aggregate_heads {
  id text [pk]
  workspace_id text [not null]
  aggregate_type text [not null]
  aggregate_id text [not null]
  current_version bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, aggregate_type, aggregate_id) [unique]
  }
  checks {
    `current_version >= 0`
  }
  Note: 'Lock this row before changing its aggregate; increment once per committed revision with business state and events. Several events may share a revision. Never reset or recycle a stream; resource IDs are immutable snapshots.'
}

Table event_consumer_receipts {
  id text [pk]
  workspace_id text [not null]
  event_id text [not null]
  consumer_key text [not null]
  processed_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, event_id, consumer_key) [unique]
  }
  Note: 'Insert this receipt with same-database side effects in one transaction. External providers need a stable event-derived idempotency key or reconciliation; this receipt alone cannot guarantee external exactly-once effects.'
}

Table event_dispatch_attempts {
  id text [pk]
  workspace_id text [not null]
  event_id text [not null]
  consumer_key text [not null]
  status delivery_status [not null, default: 'PENDING']
  attempt_count integer [not null, default: 0]
  available_at timestamptz [not null, default: `now()`]
  locked_at timestamptz
  locked_by text
  completed_at timestamptz
  last_error text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, event_id, consumer_key) [unique]
    (status, available_at, created_at)
  }
  checks {
    `(status = 'SUCCEEDED') = (completed_at IS NOT NULL)` [name: 'event_dispatch_attempts_state_3']
    `(locked_at IS NULL) = (locked_by IS NULL)` [name: 'event_dispatch_attempts_state_2']
    `(status = 'PROCESSING') = (locked_at IS NOT NULL AND locked_by IS NOT NULL)` [name: 'event_dispatch_attempts_state_1']
    `attempt_count >= 0`
  }
  Note: 'One durable queue job per event/consumer. Retry counter is state, not per-attempt history. Claim with SKIP LOCKED and recover stale leases.'
}

Table idempotency_keys {
  id text [pk]
  user_id text [not null]
  method text [not null]
  route text [not null]
  key uuid [not null]
  request_hash text [not null]
  status idempotency_status [not null, default: 'PENDING']
  response_status integer
  response_body jsonb
  response_headers jsonb [not null, default: `'{}'::jsonb`]
  completed_at timestamptz
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, method, route, key) [unique]
  }
  checks {
    `status <> 'PENDING' OR response_body IS NULL` [name: 'idempotency_keys_state_4']
    `response_status IS NULL OR response_status BETWEEN 100 AND 599` [name: 'idempotency_keys_state_3']
    `(status = 'COMPLETED') = (response_status IS NOT NULL)` [name: 'idempotency_keys_state_2']
    `(status = 'COMPLETED') = (completed_at IS NOT NULL)` [name: 'idempotency_keys_state_1']
    `expires_at > created_at`
  }
  Note: 'Global user request scope also supports signup/workspace creation; workspace-scoped routes must contain tenant in canonical route identity. Do not cache secrets.'
}

Table audit_logs {
  id text [pk]
  workspace_id text [not null]
  actor_id text
  action text [not null]
  resource_type text [not null]
  resource_id text
  request_id text
  ip_address inet
  metadata jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  Note: 'Append-only security history. resource_id is a historical identifier, explicitly not a polymorphic FK. Redact sensitive values and enforce retention.'
}


// Readable examples only; these IDs deliberately are not production ULIDs.
Records users(id, email, full_name) {
  'usr_demo_alice', 'alice@example.test', 'Alice'
  'usr_demo_bob', 'bob@example.test', 'Bob'
}
Records workspaces(id, name, slug) {
  'wsp_demo', 'Tream Demo', 'tream-demo'
}
Records memberships(id, workspace_id, user_id, role) {
  'mem_demo_alice', 'wsp_demo', 'usr_demo_alice', 'OWNER'
  'mem_demo_bob', 'wsp_demo', 'usr_demo_bob', 'MEMBER'
}
Records teams(id, workspace_id, name, key, next_issue_number) {
  'tea_demo_eng', 'wsp_demo', 'Engineering', 'ENG', 2
}
Records team_memberships(id, workspace_id, team_id, membership_id) {
  'tmem_demo_bob', 'wsp_demo', 'tea_demo_eng', 'mem_demo_bob'
}
Records issue_statuses(id, workspace_id, team_id, name, category, position, is_default) {
  'ist_demo_todo', 'wsp_demo', 'tea_demo_eng', 'Todo', 'UNSTARTED', 0, true
}
Records project_statuses(id, workspace_id, name, category, position, is_default) {
  'pst_demo_planned', 'wsp_demo', 'Planned', 'PLANNED', 0, true
}
Records projects(id, workspace_id, name, status_id, created_by_id) {
  'prj_demo_mvp', 'wsp_demo', 'Launch MVP', 'pst_demo_planned', 'mem_demo_alice'
}
Records project_teams(id, workspace_id, project_id, team_id) {
  'ptm_demo', 'wsp_demo', 'prj_demo_mvp', 'tea_demo_eng'
}
Records cycles(id, workspace_id, team_id, number, name, starts_at, ends_at) {
  'cyc_demo_1', 'wsp_demo', 'tea_demo_eng', 1, 'Cycle 1', '2026-10-01T00:00:00Z', '2026-10-15T00:00:00Z'
}
Records issues(id, workspace_id, team_id, number, identifier, title, status_id, assignee_id, created_by_id, project_id, cycle_id) {
  'iss_demo_1', 'wsp_demo', 'tea_demo_eng', 1, 'ENG-1', 'Connect issue screens to API', 'ist_demo_todo', 'mem_demo_bob', 'mem_demo_alice', 'prj_demo_mvp', 'cyc_demo_1'
}
Records issue_identifiers(id, workspace_id, issue_id, identifier) {
  'iid_demo_1', 'wsp_demo', 'iss_demo_1', 'ENG-1'
}

Ref: event_aggregate_heads.workspace_id > workspaces.id
Ref: events.(workspace_id, aggregate_type, aggregate_id) > event_aggregate_heads.(workspace_id, aggregate_type, aggregate_id)

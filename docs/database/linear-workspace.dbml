  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  checks {
    `consumed_at IS NULL OR (consumed_at >= created_at AND consumed_at < expires_at)` [name: 'integration_oauth_states_state_1']
    `expires_at > created_at`
  }
  Note: 'integration_id is null on initial connection; create integration only after validated OAuth callback.'
}

Table webhook_endpoints {

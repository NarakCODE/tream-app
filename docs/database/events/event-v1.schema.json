  "$defs": {
    "workspace_created_v1": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_membership_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["workspace_id", "owner_membership_id"],
      "additionalProperties": false
    },
    "team_created_v1": {
      "type": "object",
      "properties": {
        "team_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "default_status_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["team_id", "key", "default_status_id"],
      "additionalProperties": false
    },
    "team_updated_v1": {
      "type": "object",
      "properties": {
        "team_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "changed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "name",
              "key",
              "description",
              "timezone",
              "cycle_settings",
              "default_status",
              "retired_at"
            ]
          }
        }
      },
      "required": ["team_id", "changed_fields"],
      "additionalProperties": false
    },
    "team_retired_v1": {
      "type": "object",
      "properties": {
        "team_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retired_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["team_id", "retired_at"],
      "additionalProperties": false
    },
    "issue_created_v1": {
      "type": "object",
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "team_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "identifier": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[1-9][0-9]*$"
        },
        "status_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "cycle_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "assignee_membership_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "issue_id",
        "team_id",
        "identifier",
        "status_id",
        "project_id",
        "cycle_id",
        "assignee_membership_id"
      ],
      "additionalProperties": false
    },
    "issue_updated_v1": {
      "type": "object",
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "changed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "title",
              "description",
              "priority",
              "estimate",
              "due_date",
              "project_id",
              "cycle_id",
              "status_id",
              "assignee_membership_id",
              "parent_issue_id",
              "milestone_id"
            ]
          }
        }
      },
      "required": ["issue_id", "changed_fields"],
      "additionalProperties": false
    },
    "issue_assigned_v1": {
      "type": "object",
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "previous_assignee_membership_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"

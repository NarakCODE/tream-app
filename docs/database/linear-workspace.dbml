  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  checks {
    `size_bytes >= 0`
  }
  Note: 'Private object storage. Generate signed URLs after authorization; do not store public access URLs.'
}

Table attachments {
  id text [pk]
  workspace_id text [not null]

{
  "name": "tream-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=server --filter=client",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "shadcn": "pnpm --filter client shadcn",
    "local:setup": "pnpm --filter server local:setup",
    "local:up": "pnpm --filter server local:up",
    "local:down": "pnpm --filter server local:down",
    "local:status": "pnpm --filter server local:status"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  }
}

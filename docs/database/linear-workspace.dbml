Table intake_requests {
  id text [pk]
  workspace_id text [not null]
  team_id text [not null]
  submitted_by_id text [not null]
  title text [not null]
  body text
  state text [not null, default: 'SUBMITTED']
  converted_issue_id text
  resolved_by_id text
  resolved_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  checks {
    `state IN ('SUBMITTED', 'ACCEPTED', 'DECLINED')`
    `converted_issue_id IS NULL OR state = 'ACCEPTED'`
  }
  Note: 'Asks-style member intake. Conversion creates an issue transactionally; optional feature beyond current API.'
}

Table customer_requests {
  id text [pk]
  workspace_id text [not null]
  contact_id text [not null]
  submitted_by_id text [not null]
  title text [not null]
  body text
  source text
  external_reference text
  state text [not null, default: 'OPEN']
  archived_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  checks {
    `archived_at IS NULL OR deleted_at IS NULL` [name: 'customer_requests_lifecycle_exclusive']
    `state IN ('OPEN', 'PLANNED', 'DELIVERED', 'DECLINED')`
  }
  Note: 'Optional bridge from CRM customer feedback to product planning; not a CRM Task.'
}

Table customer_request_links {
  id text [pk]
  workspace_id text [not null]
  request_id text [not null]
  issue_id text
  project_id text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  checks {
    `num_nonnulls(issue_id, project_id) = 1`
  }
  Note: 'SQL partial unique indexes deduplicate each request/issue or request/project.'
}

Table releases {
  id text [pk]
  workspace_id text [not null]
  name text [not null]
  description text
  version text
  state text [not null, default: 'PLANNED']
  target_date date
  released_at timestamptz
  created_by_id text [not null]
  archived_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  checks {
    `archived_at IS NULL OR deleted_at IS NULL` [name: 'releases_lifecycle_exclusive']
    `state IN ('PLANNED', 'IN_PROGRESS', 'RELEASED', 'CANCELED')`
  }
  Note: 'Product release planning; separate from deployment environments or CI execution.'
}

Table release_projects {
  id text [pk]
  workspace_id text [not null]
  release_id text [not null]
  project_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, release_id, project_id) [unique]
  }
}

Table release_issues {
  id text [pk]
  workspace_id text [not null]
  release_id text [not null]
  issue_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, release_id, issue_id) [unique]
  }
}

Table sla_policies {
  id text [pk]
  workspace_id text [not null]
  team_id text [not null]
  name text [not null]
  priority work_priority [not null]
  response_minutes integer [not null]
  resolution_minutes integer [not null]
  enabled boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, team_id, id) [unique]
    (workspace_id, team_id, priority) [unique]
  }
  checks {
    `response_minutes > 0`
    `resolution_minutes >= response_minutes`
  }
  Note: 'Simple elapsed-time SLA. Business-hours calendars and policy versioning are outside this model.'
}

Table issue_sla_targets {
  id text [pk]
  workspace_id text [not null]
  issue_id text [not null]
  team_id text [not null]
  policy_id text [not null]
  response_due_at timestamptz [not null]
  resolution_due_at timestamptz [not null]
  responded_at timestamptz
  resolved_at timestamptz
  breached_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, issue_id) [unique]
  }
  checks {
    `resolution_due_at >= response_due_at`
  }
  Note: 'Snapshot computed deadlines when applying policy; update transactionally on team transfers. Scheduler emits breach notifications.'
}

Table project_templates {
  id text [pk]
  workspace_id text [not null]
  name text [not null]
  description text
  body_template text
  defaults jsonb [not null, default: `'{}'::jsonb`]
  milestone_templates jsonb [not null, default: `'[]'::jsonb`]
  created_by_id text [not null]
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  Note: 'Validated snapshots; apply by creating project, teams and milestones atomically. No fake FKs for IDs embedded in JSON.'
}

Table custom_emojis {
  id text [pk]
  workspace_id text [not null]
  name text [not null]
  file_id text [not null]
  created_by_id text [not null]
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, name) [unique]
  }
  Note: 'Names reserved after archival. Reactions preserve their emoji token; validate custom tokens against this catalog when created.'
}

Table initiative_subscribers {
  id text [pk]
  workspace_id text [not null]
  initiative_id text [not null]
  membership_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, initiative_id, membership_id) [unique]
  }
}

Table passkeys {
  id text [pk]
  user_id text [not null]
  credential_id text [not null, unique]
  public_key bytea [not null]
  sign_count bigint [not null, default: 0]
  name text
  transports jsonb [not null, default: `'[]'::jsonb`]
  backup_eligible boolean [not null, default: false]
  backed_up boolean [not null, default: false]
  last_used_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `sign_count >= 0`
    `NOT backed_up OR backup_eligible`
  }
  Note: 'WebAuthn credential public material only. One-time challenge state and origin/RP verification belong to the authentication adapter. Counter rollback handling must account for synced passkeys.'
}

Table personal_api_keys {
  id text [pk]
  workspace_id text [not null]
  membership_id text [not null]
  name text [not null]
  token_prefix text [not null]
  token_hash text [not null, unique]
  scopes jsonb [not null]
  expires_at timestamptz
  last_used_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  Note: 'Workspace-scoped personal key. Show raw secret once; require active membership and current role plus granted scopes at each request.'
  checks {
    `expires_at IS NULL OR expires_at > created_at` [name: 'personal_api_keys_state_1']
  }
}

Table planning_comments {
  id text [pk]
  workspace_id text [not null]
  project_id text
  initiative_id text
  project_update_id text
  initiative_update_id text
  author_id text [not null]
  body text [not null]
  edited_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
  }
  checks {
    `num_nonnulls(project_id, initiative_id, project_update_id, initiative_update_id) = 1`
  }
  Note: 'Supports a direct project/initiative discussion or a comment on a health update, with exactly one typed owner.'
}

Table planning_comment_reactions {
  id text [pk]
  workspace_id text [not null]
  comment_id text [not null]
  membership_id text [not null]
  emoji text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, comment_id, membership_id, emoji) [unique]
  }
}

Table pull_request_review_requests {
  id text [pk]
  workspace_id text [not null]
  pull_request_id text [not null]
  reviewer_external_id text [not null]
  reviewer_membership_id text
  requested_by_id text
  requested_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, pull_request_id, reviewer_external_id) [unique]
  }
  Note: 'Outstanding provider request exists before a submitted review. Resolve after matching provider review/webhook; repeat requests update this state.'
}

Table review_file_progress {
  id text [pk]
  workspace_id text [not null]
  pull_request_id text [not null]
  membership_id text [not null]
  file_path text [not null]
  head_sha text [not null]
  viewed_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workspace_id, id) [unique]
    (workspace_id, pull_request_id, membership_id, head_sha, file_path) [unique]
  }
  Note: 'Personal viewed-file markers tied to reviewed revision. Provider adapters supply file lists/diffs and inline review threads; the review guide is presentation derived from those files.'
}


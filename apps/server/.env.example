NODE_ENV=development
PORT=3002
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tream
JWT_ISSUER=tream-api
JWT_AUDIENCE=tream-client
JWT_ACCESS_SECRET=development-only-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
MAGIC_LINK_TTL=15m
MAGIC_LINK_BASE_URL=http://localhost:3000
# smtp captures mail locally. Switch to resend once its API key and sender are configured.
MAIL_PROVIDER=smtp
RESEND_API_KEY=
# Use an address on a domain verified in Resend to deliver to registered users.
RESEND_FROM=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Tream <no-reply@localhost>

# Trust only the known number of proxy hops. Zero ignores forwarded client IPs.
TRUST_PROXY_HOPS=0
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=2000
DATABASE_QUERY_TIMEOUT_MS=10000
# local:setup enables this for mailbox delivery. Production enables designated workers only.
BACKGROUND_WORKERS_ENABLED=false
# Development only. Production requires a distinct random 32-byte hex key.
AUTH_MAIL_ENCRYPTION_KEY=c1217da7d757690115606f7c386f73964992611de8f4139a87d79f04b0128c04

# Private files: local adapters are development only; production requires s3 + clamav.
FILES_STORAGE_DRIVER=filesystem
# FILES_LOCAL_ROOT defaults to .local/files under the server working directory.
FILES_BUCKET=tream-development
FILES_REGION=us-east-1
# Optional S3-compatible endpoint and paired credentials; omit for IAM credentials.
# FILES_ENDPOINT=http://localhost:9000
# FILES_ACCESS_KEY=
# FILES_SECRET_KEY=
FILES_SCANNER_DRIVER=development
FILES_CLAMAV_HOST=localhost
FILES_CLAMAV_PORT=3310
FILES_SCAN_TIMEOUT_MS=5000
FILES_MAX_FILE_BYTES=26214400
FILES_WORKSPACE_QUOTA_BYTES=1073741824
FILES_UPLOAD_INTENT_TTL_SECONDS=86400
FILES_UPLOAD_GRANT_TTL_SECONDS=300
FILES_DOWNLOAD_GRANT_TTL_SECONDS=60
FILES_RETENTION_DAYS=30
FILES_CLEANUP_LEASE_SECONDS=60
FILES_CLEANUP_MAX_ATTEMPTS=10
# Use a separate random secret in production, never JWT_ACCESS_SECRET.
FILES_SIGNING_SECRET=development-only-file-grant-secret-change-me
